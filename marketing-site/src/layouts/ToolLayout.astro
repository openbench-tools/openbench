---
import BaseLayout from './BaseLayout.astro';
import DownloadButton from '../components/DownloadButton.astro';
import DonateWidget from '../components/DonateWidget.astro';
import EmailCapture from '../components/EmailCapture.astro';

interface Props {
  name: string;
  tagline: string;
  description: string;
  status: 'live' | 'coming-soon';
  protocol?: string;
  features: string[];
  requirements: string[];
  sourceUrl: string;
  docsUrl?: string;
  downloadUrl?: string;
  version?: string;
  releaseDate?: Date;
  screenshot?: string;
  screenshotAlt?: string;
  slug: string;
}

const {
  name,
  tagline,
  description,
  status,
  protocol,
  features,
  requirements,
  sourceUrl,
  docsUrl,
  downloadUrl,
  version,
  releaseDate,
  screenshot,
  screenshotAlt,
  slug,
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows 10, Windows 11',
  description,
  ...(version ? { softwareVersion: version } : {}),
  ...(releaseDate ? { datePublished: releaseDate.toISOString().slice(0, 10) } : {}),
  ...(status === 'live' ? { downloadUrl: downloadUrl ?? `${sourceUrl}/releases/latest` } : {}),
  ...(screenshot ? { screenshot: new URL(screenshot, Astro.site).href } : {}),
  license: `${sourceUrl}/blob/main/tool-modbus-sim/LICENSE`,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<BaseLayout title={name} description={tagline}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="blueprint-hero relative overflow-hidden bg-[var(--ob-blueprint-800)] py-16 text-white">
    <div class="blueprint-grid pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-5xl px-6">
      <p class="font-mono text-xs uppercase tracking-widest text-[var(--ob-blueprint-300)]">
        {protocol ?? 'OpenBench tool'}
      </p>
      <h1 class="mt-3 font-display text-4xl font-700 sm:text-5xl">{name}</h1>
      <p class="mt-4 max-w-2xl text-lg text-[var(--ob-blueprint-300)]">{tagline}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <DownloadButton sourceUrl={sourceUrl} status={status} toolName={slug} downloadUrl={downloadUrl} />
        <a
          href={sourceUrl}
          data-event="source_click"
          data-tool={slug}
          class="font-mono text-sm text-[var(--ob-blueprint-300)] hover:text-white"
        >
          View source →
        </a>
        {docsUrl && (
          <a
            href={docsUrl}
            data-event="docs_click"
            data-tool={slug}
            class="font-mono text-sm text-[var(--ob-blueprint-300)] hover:text-white"
          >
            Docs →
          </a>
        )}
      </div>
    </div>
  </section>

  {screenshot && (
    <section class="border-b border-[var(--ob-paper-line)] bg-[var(--ob-blueprint-900)]">
      <div class="mx-auto max-w-5xl px-6 py-10">
        <img
          src={screenshot}
          alt={screenshotAlt ?? `${name} — application screenshot`}
          width="1709"
          height="1092"
          loading="lazy"
          class="w-full rounded-md border border-[var(--ob-blueprint-600)] shadow-lg"
        />
      </div>
    </section>
  )}

  <section class="mx-auto max-w-5xl px-6 py-14">
    <div class="grid gap-12 sm:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="font-display text-xl font-600">Overview</h2>
        <div class="prose-ob mt-4 text-[var(--ob-ink)]/85">
          <slot />
        </div>
      </div>

      <div class="space-y-8">
        <div>
          <h2 class="font-display text-sm font-600 uppercase tracking-wide text-[var(--ob-ink)]/60">
            Spec sheet
          </h2>
          <dl class="mt-3 divide-y divide-[var(--ob-paper-line)] border-y border-[var(--ob-paper-line)] font-mono text-sm">
            {features.map((f) => (
              <div class="flex gap-4 py-2">
                <dt class="text-[var(--ob-amber-dim)]">▸</dt>
                <dd>{f}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div>
          <h2 class="font-display text-sm font-600 uppercase tracking-wide text-[var(--ob-ink)]/60">
            Requirements
          </h2>
          <ul class="mt-3 space-y-1 font-mono text-sm text-[var(--ob-ink)]/80">
            {requirements.map((r) => (
              <li>— {r}</li>
            ))}
          </ul>
        </div>

        <DonateWidget context={slug} />
      </div>
    </div>
  </section>

  <EmailCapture tool={slug} />
</BaseLayout>
