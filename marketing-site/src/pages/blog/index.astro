---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title="Blog"
  description="Release notes and updates from OpenBench — free, open-source tools for the test bench."
>
  <section class="mx-auto max-w-2xl px-6 py-16">
    <h1 class="font-display text-3xl font-700">Blog</h1>
    <p class="mt-3 text-[var(--ob-ink)]/75">
      Release notes and the occasional note on what's being built.
      <a href="/rss.xml" class="font-mono text-sm text-[var(--ob-amber-dim)] hover:text-[var(--ob-amber)]">RSS</a>
    </p>

    {posts.length === 0 && (
      <p class="mt-10 font-mono text-sm text-[var(--ob-ink)]/60">No posts yet.</p>
    )}

    <ul class="mt-10 space-y-10">
      {posts.map((post) => (
        <li>
          <p class="font-mono text-xs text-[var(--ob-ink)]/50">
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            {post.data.tags.includes('release') && ' · Release notes'}
          </p>
          <h2 class="mt-1 font-display text-xl font-600">
            <a href={`/blog/${post.id}`} class="hover:text-[var(--ob-amber-dim)]">
              {post.data.title}
            </a>
          </h2>
          <p class="mt-2 text-sm text-[var(--ob-ink)]/75">{post.data.description}</p>
          <a
            href={`/blog/${post.id}`}
            class="mt-3 inline-block font-mono text-xs text-[var(--ob-amber-dim)] hover:text-[var(--ob-amber)]"
          >
            Read →
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
