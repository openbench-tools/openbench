# Copy to `.env` for local dev, or set in the host's env (Cloudflare Pages →
# Settings → Variables and Secrets) for production.

# Domain registered in Plausible. When set, the Plausible script loads and
# custom events (download_click, donate_click, docs_click, source_click,
# releases_click, pro_interest) start reporting. Leave unset to disable analytics.
PUBLIC_PLAUSIBLE_DOMAIN=openbench.dev
